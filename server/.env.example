PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/odoo
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_key
SMTP_SECURE=false
EMAIL_FROM="App Name" <noreply@example.com>
# Optional service preset: gmail, sendgrid, ses (if set, overrides SMTP_HOST/SMTP_PORT)
# EMAIL_SERVICE=gmail

# Image Storage / Cloudinary Configuration (Optional - falls back to Base64 in development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Bootstrap (Optional for scripts/create-admin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSuperSecurePassword123!
ADMIN_NAME="Template Administrator"
ADMIN_PHONE="+1 555-0100"

